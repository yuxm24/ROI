# Include only inference build inputs from this deployment context.
*
!shared/
!shared/pyproject.toml
!shared/LICENSE
!shared/NOTICE
!shared/src/
!shared/src/**/
!shared/src/**/*.py
!inference/
!inference/pyproject.toml
!inference/LICENSE
!inference/NOTICE
!inference/LICENSES/
!inference/LICENSES/*.txt
!inference/src/
!inference/src/**/
!inference/src/**/*.py
!configs/
!configs/*.example.json
!docker/
!docker/Dockerfile
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/build/
**/dist/
**/*.local.json
**/.env*
